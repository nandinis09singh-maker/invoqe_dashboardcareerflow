# CareerFlow Server Environment Variables
PORT=5000
NODE_ENV=production
# Generate a strong 32+ character random string for production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
# In production on Render, set this to your hosted frontend URL (e.g. https://careerflow.vercel.app)
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
